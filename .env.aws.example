# AWS 데모 배포용 .env — 이름만 적습니다(값은 서버의 .env 에만). infra/compose.aws.yml · ADR-039 참고.
# 내부 비밀값은 로컬처럼 tools/init_env.py(make init)로 만들 수 있습니다 — 외부 키는 직접 넣습니다.

# ── 배포 전용 ──
RDS_HOST=
RDS_PORT=
PUBLIC_ORIGIN=

# ── DB 계정(RDS 초기화 스크립트가 같은 비밀번호로 만듦) ──
DB_MIGRATOR_PASSWORD=
DB_API_PASSWORD=
DB_COLLECTOR_PASSWORD=
# db 를 띄우지 않아도 compose 가 파일 전체를 해석하므로 아무 값이나 필요
DB_ROOT_PASSWORD=

# ── Redis ACL ──
REDIS_PASSWORD=
REDIS_API_PASSWORD=
REDIS_COLLECTOR_PASSWORD=
REDIS_AIS_PASSWORD=

# ── 외부 키(선택) ──
aisstream_key=
KMA_APIHUB_KEY=
DATA_GO_KR_SERVICE_KEY=
HTTP_USER_AGENT=
