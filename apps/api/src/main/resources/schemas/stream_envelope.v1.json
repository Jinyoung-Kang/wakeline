{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wakeline.invalid/schemas/stream_envelope.v1.json",
  "title": "StreamEnvelope",
  "description": "Redis Streams 엔트리의 필드. 값은 모두 문자열. payload 는 gzip 후 base64 한 JSON.",
  "type": "object",
  "required": ["schema_version", "kind", "scope", "provider", "fetched_at", "raw_ref", "encoding", "count", "payload"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "1" },
    "kind": { "enum": ["aircraft", "sigmet", "radar", "metar", "ships", "ais_gap"] },
    "scope": { "enum": ["region", "global", "hot", "focus", "ships", "-"], "description": "aircraft: region(고정 관심 지역) · global(전세계) · hot(뷰포트 핫 리전 셀) · focus(선택 항공기 집중 추적). ships·ais_gap: ships" },
    "provider": { "type": "string" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "raw_ref": { "type": "string", "description": "raw/{provider}/{yyyymmdd}/{hhmmss}.json.gz 또는 fixture 경로" },
    "encoding": { "const": "gzip+base64" },
    "count": { "type": "string", "pattern": "^[0-9]+$" },
    "run_id": { "type": "string" },
    "payload": { "type": "string" }
  },
  "$defs": {
    "aircraft_payload": {
      "type": "object",
      "required": ["states"],
      "properties": {
        "region": { "type": ["object", "null"], "description": "조회 원(region·hot). global·focus 는 null", "properties": { "lat": {"type": "number"}, "lon": {"type": "number"}, "radius_nm": {"type": "number"} } },
        "cell": { "type": "string", "pattern": "^-?[0-9]{1,2}\\.[05]:-?[0-9]{1,3}\\.[05]:(50|100|150|200|250)$", "description": "scope hot 전용: 수요 임대의 셀 키 {lat:.1f}:{lon:.1f}:{radius_nm} (0.5° 격자)" },
        "requested": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^[0-9a-f]{6}$" }, "description": "scope focus 전용: 이 요청에서 조회한 hex" },
        "missing": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^[0-9a-f]{6}$" }, "description": "scope focus 전용: requested 중 쓸 수 있는 위치가 오지 않은 hex(응답에 없음 또는 격리)" },
        "states": { "type": "array", "items": { "$ref": "aircraft_state.v1.json" } }
      }
    },
    "sigmet_payload": {
      "type": "object",
      "required": ["sigmets"],
      "properties": { "sigmets": { "type": "array", "items": { "$ref": "sigmet.v1.json" } } }
    },
    "ships_payload": {
      "type": "object",
      "required": ["ships", "static", "stats"],
      "description": "kind ships(scope ships): 직전 발행(10 s) 이후 바뀐 선박만(계약 v2 §B1). 한 엔트리에 ships·static 각 최대 5,000건 — 넘으면 같은 발행을 part/parts 로 나눈다(stats 는 모든 part 에 같은 값이므로 집계는 part 1 만). 실시간 AIS 원문은 보관하지 않아 봉투 raw_ref 는 '-'(fixture 는 fixture 경로), count 는 ships 건수",
      "properties": {
        "ships": { "type": "array", "maxItems": 5000, "items": { "$ref": "ship_state.v1.json" } },
        "static": { "type": "array", "maxItems": 5000, "items": { "$ref": "ship_static.v1.json" } },
        "part": { "type": "integer", "minimum": 1, "description": "같은 발행 안의 순번(1부터)" },
        "parts": { "type": "integer", "minimum": 1, "description": "같은 발행의 엔트리 수" },
        "stats": {
          "type": "object",
          "required": ["msgs", "msgs_per_s", "dropped", "quarantined", "connected"],
          "description": "수신 통계. msgs·dropped·quarantined·invalid 는 이번 창(직전 발행 틱 이후 window_s 초)의 건수 — 누적값은 상태 해시 wakeline:ais:status",
          "properties": {
            "msgs": { "type": "integer", "minimum": 0, "description": "이번 창에 받은 메시지 수" },
            "msgs_per_s": { "type": "number", "minimum": 0 },
            "dropped": { "type": "integer", "minimum": 0, "description": "대기열(20,000)이 가득 차 버린 원문 수" },
            "quarantined": { "type": "integer", "minimum": 0, "description": "품질 게이트가 격리한 위치 수(position_jump · seen_in_future · stale_position)" },
            "invalid": { "type": "integer", "minimum": 0, "description": "형식·MMSI·시각·범위 오류로 버린 메시지 수" },
            "window_s": { "type": "number", "minimum": 0 },
            "connected": { "type": "boolean" },
            "bbox": { "type": "string", "description": "현재 구독 영역(정규화한 설정 문자열 lat1,lon1,lat2,lon2;…). fixture 재생은 'fixture:<파일명>'" },
            "ships_tracked": { "type": "integer", "minimum": 0, "description": "수집기가 기억하는 선박 수(마지막 갱신 30분 안)" },
            "queue_depth": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ais_gap_payload": {
      "type": "object",
      "required": ["started_at", "ended_at", "reason"],
      "additionalProperties": false,
      "description": "kind ais_gap(scope ships): AIS 수신이 끊겼다가 다시 이어진 구간 — 재전송이 없어 메울 수 없는 공백. started_at = 마지막으로 메시지를 받은 시각, ended_at = 다시 구독한 연결의 첫 메시지 시각. 발행 재시도로 같은 공백이 다시 올 수 있다 — (source, started_at) 로 중복 제거",
      "properties": {
        "started_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
        "ended_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200, "description": "공백이 열린 원인(비밀값을 가린 문구: 'server closed (1006)' · 'idle 120 s — no messages' · 'ais process stopped' 등)" }
      }
    },
    "radar_payload": {
      "type": "object",
      "required": ["host", "past", "generated"],
      "properties": {
        "host": { "type": "string" },
        "generated": { "type": "integer" },
        "past": { "type": "array", "items": { "type": "object", "required": ["time", "path"], "properties": { "time": {"type": "integer"}, "path": {"type": "string"} } } }
      }
    }
  }
}
