{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skywx.dev/schemas/sigmet.v1.json",
  "title": "Sigmet",
  "description": "구조화된 SIGMET 1건. geometry 가 null 이면 판정에서 제외(excluded_reason 에 사유).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "fir_id", "series_id", "hazard", "base_ft", "top_ft", "valid_from", "valid_to", "geometry", "raw_text", "provider", "fetched_at"],
  "properties": {
    "id": { "type": "string", "description": "fir_id:series_id:valid_from(unix) 자연키" },
    "fir_id": { "type": "string" },
    "fir_name": { "type": ["string", "null"] },
    "issuer": { "type": ["string", "null"] },
    "series_id": { "type": "string" },
    "hazard": { "type": "string" },
    "qualifier": { "type": ["string", "null"] },
    "base_ft": { "type": "integer", "minimum": 0 },
    "top_ft": { "type": ["integer", "null"] },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "type": "string", "format": "date-time" },
    "geometry": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "MultiPolygon" },
            "coordinates": { "type": "array" }
          }
        }
      ]
    },
    "excluded_reason": { "type": ["string", "null"] },
    "move_dir": { "type": ["string", "null"] },
    "move_spd": { "type": ["string", "null"] },
    "chng": { "type": ["string", "null"] },
    "raw_text": { "type": "string" },
    "provider": { "type": "string", "enum": ["awc_isigmet", "awc_airsigmet", "fixture"] },
    "fetched_at": { "type": "string", "format": "date-time" }
  }
}
